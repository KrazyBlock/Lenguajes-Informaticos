#17. Pide un número y verifica si es primo.
num = int(input("Introduce un número entero: "))
if num <= 1:
    print(num," no es un número primo.")
else:
    encontro_divisor = 0
    i = 2
    while i < num and encontro_divisor == 0:
        if num % i == 0:
            encontro_divisor = 1
        i = i + 1
    if encontro_divisor == 0:
        print(num," es un número primo.")
    else:
        print(num," no es un número primo.")

